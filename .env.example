# Copia este archivo a .env y completa los valores. .env NO se commitea.

# API key de Spoonacular (https://spoonacular.com/food-api -> crear cuenta -> My Console -> API Key)
SPOONACULAR_API_KEY=

# API key de NewsData.io (https://newsdata.io -> Get API Key gratis -> Dashboard)
NEWSDATA_API_KEY=

# API key de Anthropic para Wooly, el asistente de IA (https://console.anthropic.com)
ANTHROPIC_API_KEY=

# Opcionales
# PORT=3000
# DB_FILE=./data/nicy.db
